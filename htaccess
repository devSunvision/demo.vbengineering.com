RewriteEngine On

# ----------------------------------------
# 1. FORCE HTTPS + NON-WWW
# ----------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.vbengg\.com$ [NC]
RewriteRule ^(.*)$ https://vbengg.com/$1 [R=301,L]

# ----------------------------------------
# 2. FIX BITRIX DUPLICATES
# ----------------------------------------
RewriteRule ^bitrix24/bitrix24/index\.html$ /contact [R=301,L]
RewriteRule ^bitrix24/ - [R=404,L]

# ----------------------------------------
# 2A. FIX GOOGLE 404 + DUPLICATE URLs
# ----------------------------------------

# Duplicate page redirect
RewriteRule ^risk-assessments-consultancy\.html$ /arc-flash-risk-assessment.html [R=301,L]

# Removed pages
Redirect gone /motor-strating-studies.html
Redirect gone /lightning-arrester.html

# Saudi arc flash study fix
RewriteRule ^Arc-flash-study-saudi-ar$ /arc-flash-study-saudi-arabia.html [R=301,L,NC]
RewriteRule ^arc-flash-study-saudi-ar$ /arc-flash-study-saudi-arabia.html [R=301,L]

# South Korea fix
RewriteRule ^arc-flash-risk-assessment-South%20Korea$ /arc-flash-risk-assessment-south-korea.html [R=301,L,NC]

# Language duplicates
RewriteRule ^arc-flash-risk-assessment-german$ /arc-flash-risk-assessment.html [R=301,L]
RewriteRule ^arc-flash-risk-assessment-russia$ /arc-flash-risk-assessment.html [R=301,L]
RewriteRule ^arc-flash-risk-assessment-spanish$ /arc-flash-risk-assessment.html [R=301,L]

# Nested URL fixes
RewriteRule ^reverse-engineering-consultancy\.html/fire-escape-floor-plan-drawings\.html$ /fire-escape-floor-plan-drawings.html [R=301,L]
RewriteRule ^reverse-engineering-consultancy\.html/Electrical-safety-training\.html$ /electrical-safety-training.html [R=301,L]
RewriteRule ^reverse-engineering-consultancy\.html/PandID-Drawings-Preperation-India\.html$ /PandID-Drawings-Preperation-India.html [R=301,L]

# ----------------------------------------
# 3. PREVENT .html AS FOLDER
# ----------------------------------------
RewriteCond %{REQUEST_URI} \.html/.+
RewriteRule ^(.+?)\.html/.+$ /$1.html [R=301,L]

# ----------------------------------------
# 4. EDGECAM FIX
# ----------------------------------------
RewriteRule ^Edgecam\.HTML$ /edgecam.html [R=301,L]
RewriteRule ^Edgecam\.html$ /edgecam.html [R=301,L]
RewriteRule ^edgecam$ /edgecam.html [R=301,L]

# ----------------------------------------
# 5. LOAD .html FILES INTERNALLY
# ----------------------------------------
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [L]

# ----------------------------------------
# 6. LOAD .php FILES INTERNALLY
# ----------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [L]

# ----------------------------------------
# 7. FIX INDEX.HTML DUPLICATES
# ----------------------------------------
RewriteRule ^index\.html$ / [R=301,L,NC]
RewriteRule ^(.*)/index\.html$ /$1/ [R=301,L,NC]

# ----------------------------------------
# 8. REMOVE TRAILING SLASH
# ----------------------------------------
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.*)/$ /$1 [R=301,L]